# OPENROUTER_API_KEY: Key for OpenRouter LLM API calls.
OPENROUTER_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_BACKEND_URL: The backend system URL used by the agents and system.
VITE_BACKEND_URL="http://192.168.0.165:8000"

# APPLICATION_LOG_PATH: The file path where application/system logs will be saved.
APPLICATION_LOG_PATH="logs/app.log"
